<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Blessed Vines Preparatory School — Building leaders and innovators of tomorrow." />
    <title>Blessed Vines Preparatory School | Future Leaders</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
  </head>
  <body>
    <div id="root"></div>
    <script>window.VINES_YEAR = <%= year %>; window.VINES_PAGE = <%- JSON.stringify(page) %>;</script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script>
      fetch('/js/app.jsx?v=20260927-logo')
        .then((response) => response.text())
        .then((source) => {
          const compiled = Babel.transform(source, { presets: ['react'] }).code;
          const app = document.createElement('script');
          app.text = compiled;
          document.body.appendChild(app);
        })
        .catch((error) => { document.getElementById('root').textContent = `Unable to load the school platform: ${error.message}`; });
    </script>
  </body>
</html>
