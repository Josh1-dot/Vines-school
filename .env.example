PORT=3000
# Local development stores data in data/school.json. Use a dedicated database in production.
NODE_ENV=development
DEMO_MODE=true
MONGODB_URI=
MONGODB_DB=vines_school
# Real school contact details; leave blank until confirmed.
SCHOOL_PHONE=
SCHOOL_EMAIL=
SCHOOL_ADDRESS=
SCHOOL_VIDEO_URL=
# Notifications are queued. Delivery remains off until explicitly enabled.
EMAIL_DELIVERY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
